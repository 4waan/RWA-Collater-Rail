{
  "name": "rwa-credit-rail",
  "description": "Originate bilateral HBAR loans against Hedera ATS securities with partition holds, HSS maturity settlement, and Mirror-verifiable lifecycle evidence.",
  "version": "1.0.0",
  "create-scaffold-hbar": {
    "requirements": {
      "node": ">=22 <23",
      "forge": ">=1.5.1"
    },
    "capabilities": {
      "frontend": ["nextjs-app"],
      "solidityFramework": ["foundry"],
      "packageManager": ["yarn"]
    },
    "defaults": {
      "frontend": "nextjs-app",
      "solidityFramework": "foundry",
      "packageManager": "yarn"
    },
    "outro": {
      "sections": [
        {
          "title": "Inspect without secrets",
          "steps": [
            {
              "label": "List the financing recipes",
              "command": "{run:recipe:list}"
            },
            {
              "label": "Start reference mode",
              "command": "{run:dev}"
            },
            {
              "text": "Open http://localhost:3000, choose a recipe, and replay its lifecycle without a wallet."
            }
          ]
        },
        {
          "title": "Build a live facility",
          "steps": [
            {
              "label": "Create and fund Hedera testnet accounts",
              "url": "https://portal.hedera.com/"
            },
            {
              "label": "Copy the private Foundry environment",
              "command": "cp packages/foundry/.env.example packages/foundry/.env"
            },
            {
              "label": "Import the funded operator into an encrypted Foundry account",
              "command": "cast wallet import hedera-operator --interactive"
            },
            {
              "text": "Set HEDERA_OPERATOR_ADDRESS, LENDER_ADDRESS, and BORROWER_ADDRESS in packages/foundry/.env before deployment. These are public addresses only. Keep every private key in the encrypted Foundry account."
            },
            {
              "label": "Deploy the default ATS bond and rail recipe",
              "command": "{run:bootstrap:testnet} --recipe term-credit"
            },
            {
              "label": "Confirm live state through Mirror Node",
              "command": "{run:verify:deployment}"
            },
            {
              "label": "Run every local gate",
              "command": "yarn release:validate"
            }
          ]
        }
      ]
    }
  }
}
