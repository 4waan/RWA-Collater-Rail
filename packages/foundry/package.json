{
  "name": "@collateral-rail/foundry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "forge build",
    "size": "forge build --sizes --skip test --skip script --offline",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check",
    "test": "forge test --offline -vvv",
    "test:hts": "FOUNDRY_INVARIANT_RUNS=64 FOUNDRY_INVARIANT_DEPTH=32 forge test --offline --match-contract '(AtsCollateralRailHtsTest|PythUsdOracleTest|HtsRailAcceptanceTest|HtsRailMathFuzzTest|HtsRailSolvencyInvariantTest)'",
    "fuzz": "forge test --offline --match-path 'test/fuzz/*.t.sol' -vvv",
    "invariant": "forge test --offline --match-path 'test/invariant/*.t.sol' -vvv",
    "bootstrap:testnet": "node scripts/bootstrap-local.mjs",
    "demo:testnet": "node --import tsx scripts/demo-testnet.ts",
    "demo:testnet:hts:controlled": "node --import tsx scripts/demo-testnet-hts.mjs --profile=controlled",
    "demo:testnet:hts:usdc": "node --import tsx scripts/demo-testnet-hts.mjs --profile=usdc",
    "prepare:testnet:hts:usdc": "node --import tsx scripts/run-hts-from-operator.mjs prepare-usdc",
    "run:testnet:hts:controlled": "node --import tsx scripts/run-hts-from-operator.mjs controlled",
    "run:testnet:hts:usdc": "node --import tsx scripts/run-hts-from-operator.mjs usdc",
    "publish:testnet": "node scripts/publish-evidence.mjs",
    "publish:testnet:hts:controlled": "node scripts/publish-evidence-hts.mjs controlled",
    "publish:testnet:hts:usdc": "node scripts/publish-evidence-hts.mjs usdc",
    "test:runner": "node --import tsx --test scripts/test/*.test.mjs ../nextjs/lib/*.test.ts",
    "typecheck:runner": "tsc --project tsconfig.scripts.json",
    "verify:deployment": "node --import tsx scripts/verify-deployment.mjs deployments/testnet.json",
    "verify:deployment:hts": "node --import tsx scripts/verify-deployment-hts.mjs",
    "check:ats-abi": "node scripts/check-ats-interface.mjs"
  },
  "dependencies": {
    "@collateral-rail/shared": "workspace:*",
    "@hiero-ledger/hiero-contracts": "0.2.0",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@hiero-ledger/sdk": "2.88.0",
    "@types/node": "22.18.6",
    "tsx": "4.20.6",
    "typescript": "5.8.2"
  }
}
