# Hedera JSON-RPC relay. Public endpoints are rate limited.
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
PYTH_HERMES_URL=https://hermes.pyth.network

# Default oracle modes. Pyth must be selected explicitly.
DEMO_ORACLE_KIND=hedera-exchange-rate
USE_PYTH_ORACLE=0

# Path to an encrypted Foundry keystore. Keep the key out of this file.
HEDERA_KEYSTORE_PATH=

# Password source consumed by Foundry. Prefer an interactive prompt in local use.
HEDERA_KEYSTORE_PASSWORD_FILE=

# Public EVM address for the encrypted operator above.
HEDERA_OPERATOR_ADDRESS=

# EVM addresses for funded testnet participants.
LENDER_ADDRESS=
BORROWER_ADDRESS=

# Optional overrides. Pyth is read only when Pyth mode is selected.
ATS_RESOLVER_ADDRESS=0xBA2D5FC2083A0b8f164c50e65d782087fBA18E0a
ATS_FACTORY_ADDRESS=0xd1F118A40f3b02883D35909eF2517e7EDd78379d
PYTH_ADDRESS=0xA2aa501b19aff244D90cc15a4Cf739D2725B5729
